# Server-only PostgreSQL connection (Supabase or another PostgreSQL provider).
# For Supabase on Vercel, use the exact shared pooler host from the Connect dialog.
DATABASE_URL=postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&uselibpqcompat=true&pgbouncer=true

# The existing spreadsheet. Do not create a replacement spreadsheet.
GOOGLE_SHEET_ID=14u23WYNh2OTwBk-5AgNj5nOSGpDUMhSIE_aOzgF7-do
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the private key server-only. Either use escaped \n characters here,
# or set GOOGLE_SERVICE_ACCOUNT_JSON to the full JSON key in the host's secret manager.
GOOGLE_PRIVATE_KEY=

# Leave empty for a root Vercel deployment. Set /00 only for a deployment that needs that prefix.
NEXT_PUBLIC_BASE_PATH=
